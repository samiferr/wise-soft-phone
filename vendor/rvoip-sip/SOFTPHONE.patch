+    /// Audio format negotiated by SDP offer/answer for this exact call.
+    ///
+    /// Frames sent through [`AudioSender`] must match this sample rate and
+    /// channel count: the encoder rejects any other shape. Returns `Ok(None)`
+    /// before SDP negotiation has completed.
+    pub async fn negotiated_audio(&self) -> Result<Option<NegotiatedAudio>> {
+        let handle = self.exact_lifecycle_handle()?;
+        Ok(self
+            .coordinator
+            .helpers
+            .negotiated_media_config_exact(&handle)
+            .await?
+            .map(|(config, payload_type)| NegotiatedAudio {
+                codec: config.codec,
+                sample_rate: config.sample_rate,
+                channels: config.channels,
+                payload_type,
+            }))
+    }
+
     /// Get the current negotiated media-security state for this call.
     ///
     /// Returns `Ok(None)` when media is plaintext or SRTP has not been
@@ -2182,3 +2202,16 @@
         ));
     }
 }
+
+/// Audio codec and PCM shape negotiated for a call.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NegotiatedAudio {
+    /// Canonical codec name, for example `PCMU`, `PCMA`, or `opus`.
+    pub codec: String,
+    /// RTP clock rate and PCM sample rate in Hz.
+    pub sample_rate: u32,
+    /// PCM channel count expected by the encoder.
+    pub channels: u8,
+    /// Negotiated RTP payload type.
+    pub payload_type: u8,
+}
