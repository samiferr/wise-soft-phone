diff -ruN rvoip-sip-0.4.0/src/adapters/media_adapter.rs rvoip-sip/src/adapters/media_adapter.rs
--- rvoip-sip-0.4.0/src/adapters/media_adapter.rs	2006-07-24 01:21:28.000000000 +0000
+++ rvoip-sip/src/adapters/media_adapter.rs	2026-11-20 09:47:04.759781139 +0000
@@ -505,6 +505,19 @@
 /// answerer states its own.
 fn answer_fmtp_for_pt(offer: &SdpSession, pt: u8, g729_annex_b: bool) -> Option<String> {
     if !sdp_payload_is_amr(offer, pt) {
+        // Dynamic payload numbers belong to the offerer, and the static fmtp
+        // table is keyed on this stack's own numbering. Asterisk, for one,
+        // offers Opus on 107, which this stack uses for AMR-NB octet-aligned;
+        // keying on the number alone answered Opus with AMR framing params.
+        if pt >= 96 {
+            let name = audio_rtpmap(offer, pt).map(|mapping| mapping.encoding_name.clone());
+            let ours = match name.as_deref() {
+                Some(name) if name.eq_ignore_ascii_case("opus") => 111,
+                Some(name) if name.eq_ignore_ascii_case("telephone-event") => 101,
+                _ => return None,
+            };
+            return fmtp_for_pt_with_g729_annex_b(ours, g729_annex_b).map(ToString::to_string);
+        }
         return fmtp_for_pt_with_g729_annex_b(pt, g729_annex_b).map(ToString::to_string);
     }
 
@@ -628,8 +641,9 @@
         // stated by omitting `octet-align` rather than by setting it to 0.
         AMR_WB_OA_PT | AMR_NB_OA_PT => Some("octet-align=1; max-red=0"),
         AMR_WB_BE_PT | AMR_NB_BE_PT => Some("max-red=0"),
-        // Opus (PT 111) defaults are fine for VoIP without fmtp; a
-        // production deployment may want `useinbandfec=1; minptime=10`.
+        // Opus (PT 111): ask the peer for in-band FEC, which libopus decodes
+        // as ordinary packets, and allow 10 ms packets (RFC 7587 §7).
+        111 => Some("minptime=10; useinbandfec=1"),
         _ => None,
     }
 }
