+            .map(|w| (w[1] - w[0]).abs())
+            .fold(0.0f32, f32::max);
+        // A 440 Hz, 0.5-amplitude sine moves at most ~0.029 per 48 kHz sample.
+        assert!(max_step < 0.035, "discontinuity {max_step}");
