+/// Duplicate mono samples into `channels` interleaved channels.
+fn interleave(mono: Vec<i16>, channels: usize) -> Vec<i16> {
+    if channels <= 1 {
+        return mono;
+    }
+    mono.into_iter()
+        .flat_map(|sample| std::iter::repeat_n(sample, channels))
+        .collect()
 }
 
